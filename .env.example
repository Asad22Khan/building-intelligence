# Copy to .env (untracked; never commit secrets).
# GENERATION_API_BASE_URL / GENERATION_API_KEY: supplied by the trainer for an
#   OpenAI-compatible LiteLLM proxy. Leave blank until Story 3.1 needs them.
# MONGODB_URI: Atlas free-tier (M0) connection string; the Atlas IP access list
#   must allow your machine.
# VOYAGE_API_KEY: a free key is rate limited, so Story 2.2 embedding takes ~40 minutes.
APP_ENV=development
MONGODB_URI=
MONGODB_DB_NAME=building_with_rag
MONGODB_TEST_DB_NAME=building_with_rag_test
VOYAGE_API_KEY=
CAPSTONE_API_KEY=
WEBUI_DEMO_CALLER_ID=demo-public
GENERATION_API_BASE_URL=
GENERATION_API_KEY=
GENERATION_MODEL_NAME=gpt-4o-mini
RERANK_API_BASE_URL=https://api.voyageai.com/v1
RERANK_API_KEY=
RERANK_MODEL_NAME=rerank-2.5
RERANK_REQUEST_TIMEOUT_SECONDS=30
RERANK_CANDIDATE_LIMIT=20
RERANK_SEND_LIMIT=10
RERANK_RETURN_LIMIT=5
